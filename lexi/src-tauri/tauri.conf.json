{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lexi",
  "version": "1.0.2",
  "identifier": "com.lexi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lexi",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/lexi-32x32.png",
      "icons/lexi-128x128.png",
      "icons/lexi-128x128@2x.png",
      "icons/lexi.icns",
      "icons/lexi.ico"
    ],
    "targets": ["msi", "nsis"],
    "resources": [
      "../public/dictionary.txt"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {}
  }
}